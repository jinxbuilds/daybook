# Copy to .env and fill in. Never commit .env.

# MongoDB connection string. Local example (no auth, bound to localhost only):
#   mongodb://127.0.0.1:27017/daybook
# For MongoDB Atlas, use the SRV string from your cluster and a strong,
# unique database user password.
MONGODB_URI=

# Long random secret used to sign session tokens (min 32 chars). Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Comma-separated front-end origins allowed to call the API from a browser.
# Not needed when the API serves the built front end itself (npm start).
CLIENT_ORIGIN=http://localhost:5173

PORT=4000
NODE_ENV=development

# Session lifetime in seconds (default 7 days).
# JWT_TTL_SECONDS=604800

# Cookies are Secure automatically when NODE_ENV=production.
# Set COOKIE_SAMESITE=none and COOKIE_SECURE=true only if the front end is
# hosted on a different site from the API.
# COOKIE_SAMESITE=strict
# COOKIE_SECURE=true

# Number of reverse proxies in front of the app (e.g. 1 on Render/Railway/Nginx)
# so rate limiting sees the real client IP.
# TRUST_PROXY=0
